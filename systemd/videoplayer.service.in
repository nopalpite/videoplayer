[Unit]
StartLimitIntervalSec=0
Description=Lecteur vidéo plein écran piloté par GPIO (mpv)
# Démarrage au plus tôt, sans attendre le réseau ni la fin du démarrage :
# l'intro DarkSign s'affiche dès que la carte graphique est prête.
DefaultDependencies=no
Wants=dev-dri-card0.device
After=local-fs.target dev-dri-card0.device
Conflicts=shutdown.target
Before=shutdown.target

[Service]
User=@USER@
Group=@GROUP@
WorkingDirectory=@DIR@
ExecStart=/usr/bin/python3 @DIR@/player.py
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=2
# le lecteur est le dernier processus sacrifié en cas de manque de mémoire
OOMScoreAdjust=-800

[Install]
WantedBy=multi-user.target
